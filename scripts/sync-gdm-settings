#!/usr/bin/env bash
# Sync the current user's desktop settings into GDM (login screen).
#
# Syncs:
#   - monitors.xml (layout, resolution, refresh, scale, primary)
#   - fonts, antialiasing, hinting
#   - theme / icons / cursor / color-scheme / accent
#   - clock format
#   - night light
#   - power (idle dim, suspend timeouts, power button)
#   - mouse / touchpad
#   - accessibility interface bits
#
# Does not sync wallpaper: the pre-login greeter background is theme-
# hardcoded (gresource); lock screen already uses the session wallpaper.
#
# Does not modify your user session — only GDM system config.
set -euo pipefail

GDM_DCONF_DST="/etc/dconf/db/gdm.d/00-synced-from-user"
GDM_MONITORS_HOME="/var/lib/gdm/.config/monitors.xml"
GDM_MONITORS_XDG="/etc/xdg/monitors.xml"
BOOT_SYNC_DROPIN="/etc/systemd/system/gdm.service.d/10-sync-monitors.conf"

usage() {
  cat <<'EOF'
Usage: sync-gdm-settings [--install-boot-sync] [--remove-boot-sync]

  Copies your current GNOME session look into the GDM login screen:

    Monitors
      ~/.config/monitors.xml
        → /var/lib/gdm/.config/monitors.xml
        → /etc/xdg/monitors.xml

    Desktop settings (dconf)
      fonts, AA/hinting, theme, icons, cursor, color-scheme, accent,
      clock, night light, power, mouse/touchpad, a11y
        → /etc/dconf/db/gdm.d/00-synced-from-user
        → dconf update

  --install-boot-sync   Re-copy monitors.xml before each greeter start
  --remove-boot-sync    Remove that gdm.service drop-in

Requires sudo. Re-run after you change displays / theme / power / night light.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

as_root() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  else
    sudo "$@"
  fi
}

schema_has_key() {
  local schema="$1" key="$2"
  gsettings list-keys "${schema}" 2>/dev/null | grep -qx "${key}"
}

# gsettings get already prints GVariant text — valid for dconf keyfiles.
emit_keys() {
  local schema="$1"
  shift
  local key raw
  for key in "$@"; do
    schema_has_key "${schema}" "${key}" || continue
    raw="$(gsettings get "${schema}" "${key}")"
    # Skip unusable custom sound theme name for the greeter.
    if [[ "${schema}" == "org.gnome.desktop.sound" && "${key}" == "theme-name" && "${raw}" == "'__custom'" ]]; then
      continue
    fi
    printf '%s=%s\n' "${key}" "${raw}"
  done
}

write_synced_dconf() {
  local out="$1"

  {
    printf '# Generated by sync-gdm-settings from user %s on %s\n' \
      "${USER}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '# Re-run sync-gdm-settings after changing session settings.\n\n'

    printf '[org/gnome/desktop/interface]\n'
    emit_keys org.gnome.desktop.interface \
      font-name document-font-name monospace-font-name \
      font-antialiasing font-hinting font-rendering font-rgba-order \
      text-scaling-factor \
      color-scheme accent-color \
      gtk-theme icon-theme cursor-theme cursor-size \
      enable-animations \
      clock-format clock-show-date clock-show-weekday clock-show-seconds \
      show-battery-percentage
    printf '\n'

    printf '[org/gnome/desktop/wm/preferences]\n'
    emit_keys org.gnome.desktop.wm.preferences titlebar-font
    printf '\n'

    printf '[org/gnome/settings-daemon/plugins/color]\n'
    emit_keys org.gnome.settings-daemon.plugins.color \
      night-light-enabled \
      night-light-schedule-automatic \
      night-light-schedule-from \
      night-light-schedule-to \
      night-light-temperature
    printf '\n'

    printf '[org/gnome/settings-daemon/plugins/power]\n'
    emit_keys org.gnome.settings-daemon.plugins.power \
      ambient-enabled \
      idle-brightness \
      idle-dim \
      power-button-action \
      power-saver-profile-on-low-battery \
      sleep-inactive-ac-timeout \
      sleep-inactive-ac-type \
      sleep-inactive-battery-timeout \
      sleep-inactive-battery-type
    printf '\n'

    printf '[org/gnome/desktop/peripherals/mouse]\n'
    emit_keys org.gnome.desktop.peripherals.mouse \
      accel-profile speed natural-scroll left-handed middle-click-emulation
    printf '\n'

    printf '[org/gnome/desktop/peripherals/touchpad]\n'
    emit_keys org.gnome.desktop.peripherals.touchpad \
      accel-profile speed natural-scroll tap-to-click \
      disable-while-typing click-method two-finger-scrolling-enabled \
      edge-scrolling-enabled send-events
    printf '\n'

    printf '[org/gnome/desktop/a11y/interface]\n'
    emit_keys org.gnome.desktop.a11y.interface \
      high-contrast show-status-shapes
    printf '\n'

    printf '[org/gnome/desktop/sound]\n'
    emit_keys org.gnome.desktop.sound \
      event-sounds allow-volume-above-100-percent theme-name
    printf '\n'
  } >"${out}"
}

sync_monitors() {
  local src="${HOME}/.config/monitors.xml"
  [[ -f "${src}" ]] || die "missing ${src} — set up displays in GNOME Settings first"

  local gdm_home
  gdm_home="$(getent passwd gdm | cut -d: -f6)"
  [[ -n "${gdm_home}" ]] || die "gdm user not found"

  as_root install -d -o gdm -g gdm -m 755 "${gdm_home}/.config"
  as_root install -o gdm -g gdm -m 644 "${src}" "${GDM_MONITORS_HOME}"

  as_root install -d -m 755 /etc/xdg
  as_root install -o root -g root -m 644 "${src}" "${GDM_MONITORS_XDG}"

  printf 'Synced monitors.xml →\n  %s\n  %s\n' "${GDM_MONITORS_HOME}" "${GDM_MONITORS_XDG}"
}

sync_dconf() {
  need_cmd gsettings
  need_cmd dconf

  local tmp
  tmp="$(mktemp)"
  write_synced_dconf "${tmp}"

  as_root install -d -m 755 /etc/dconf/db/gdm.d
  as_root install -m 644 "${tmp}" "${GDM_DCONF_DST}"

  rm -f "${tmp}"

  as_root dconf update
  printf 'Synced desktop settings → %s\n' "${GDM_DCONF_DST}"
}

install_boot_sync() {
  local user_monitors="${HOME}/.config/monitors.xml"
  local dropin_dir
  dropin_dir="$(dirname -- "${BOOT_SYNC_DROPIN}")"

  as_root install -d -m 755 "${dropin_dir}"
  as_root tee "${BOOT_SYNC_DROPIN}" >/dev/null <<EOF
[Service]
# Re-copy this user's monitors.xml into GDM before the greeter starts.
ExecStartPre=/bin/bash -c 'src=${user_monitors}; if [[ -f "\$src" ]]; then install -d -o gdm -g gdm -m 755 /var/lib/gdm/.config; install -o gdm -g gdm -m 644 "\$src" /var/lib/gdm/.config/monitors.xml; install -d -m 755 /etc/xdg; install -o root -g root -m 644 "\$src" /etc/xdg/monitors.xml; fi'
EOF
  as_root systemctl daemon-reload
  printf 'Installed boot sync drop-in: %s\n' "${BOOT_SYNC_DROPIN}"
}

remove_boot_sync() {
  if [[ -f "${BOOT_SYNC_DROPIN}" ]]; then
    as_root rm -f "${BOOT_SYNC_DROPIN}"
    as_root rmdir "$(dirname -- "${BOOT_SYNC_DROPIN}")" 2>/dev/null || true
    as_root systemctl daemon-reload
    printf 'Removed boot sync drop-in.\n'
  else
    printf 'No boot sync drop-in installed.\n'
  fi
}

main() {
  local install_boot=0 remove_boot=0

  while [[ "${#}" -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --install-boot-sync)
        install_boot=1
        shift
        ;;
      --remove-boot-sync)
        remove_boot=1
        shift
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done

  need_cmd sudo
  need_cmd install
  need_cmd getent

  if ((remove_boot)); then
    remove_boot_sync
    exit 0
  fi

  sync_monitors
  sync_dconf

  if ((install_boot)); then
    install_boot_sync
  fi

  printf '\nOK: GDM synced from your session.\n'
  printf 'Applies on next greeter start (log out, or: sudo systemctl restart gdm).\n'
}

main "$@"
