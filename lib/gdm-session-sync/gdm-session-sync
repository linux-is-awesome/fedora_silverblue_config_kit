#!/usr/bin/env bash
# Mirror a user's GNOME session settings into GDM.
# --once: one-shot sync (used after install).
# default: live daemon — dconf events → GDM dconf; inotify on monitors.xml → copy.
# Reads on-disk dconf via `dconf` (no dbus-run-session).
set -u

LIB_DIR="$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "${LIB_DIR}/common.sh"

GDM_DCONF_PATH="${GDM_DCONF_PATH:-/etc/dconf/db/gdm.d/90-gdm-session-sync}"
GDM_DCONF_DB="${GDM_DCONF_DB:-/etc/dconf/db/gdm}"
GDM_DCONF_D="${GDM_DCONF_D:-/etc/dconf/db/gdm.d}"
GDM_MONITORS_HOME="${GDM_MONITORS_HOME:-/var/lib/gdm/.config/monitors.xml}"
GDM_MONITORS_XDG="${GDM_MONITORS_XDG:-/etc/xdg/monitors.xml}"
CONFIG_USER_FILE="${CONFIG_USER_FILE:-/etc/gdm-session-sync/user}"

log() {
  printf 'gdm-session-sync: %s\n' "$*" >&2
}

usage() {
  cat <<'EOF'
Usage:
  gdm-session-sync --once [--user NAME]
  gdm-session-sync [--user NAME]

  --once   One-shot sync (install). Default mode watches for changes.
  --user   User to sync from (default: /etc/gdm-session-sync/user).
EOF
}

dconf_read_user() {
  local user="$1" path="$2" home raw
  home="$(getent passwd "${user}" | cut -d: -f6)"
  [[ -n "${home}" ]] || return 1
  raw="$(runuser -u "${user}" -- env -i \
    HOME="${home}" \
    USER="${user}" \
    LOGNAME="${user}" \
    PATH="/usr/bin:/bin" \
    dconf read "${path}" 2>/dev/null)" || return 1
  [[ -n "${raw}" ]] || return 1
  printf '%s\n' "${raw}"
}

schema_key_path() {
  local schema="$1" key="$2"
  printf '/%s/%s' "${schema//.//}" "${key}"
}

get_gs() {
  local user="$1" schema="$2" key="$3"
  dconf_read_user "${user}" "$(schema_key_path "${schema}" "${key}")"
}

emit_keys() {
  local user="$1" schema="$2"
  shift 2
  local key raw
  for key in "$@"; do
    raw="$(get_gs "${user}" "${schema}" "${key}")" || continue
    if [[ "${schema}" == "org.gnome.desktop.sound" && "${key}" == "theme-name" && "${raw}" == "'__custom'" ]]; then
      continue
    fi
    printf '%s=%s\n' "${key}" "${raw}"
  done
}

write_gdm_dconf() {
  local user="$1"
  local tmp

  tmp="$(mktemp)"
  {
    printf '# Generated by gdm-session-sync from user %s on %s\n\n' \
      "${user}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    printf '[org/gnome/desktop/interface]\n'
    emit_keys "${user}" org.gnome.desktop.interface \
      font-name document-font-name monospace-font-name \
      font-antialiasing font-hinting font-rendering font-rgba-order \
      text-scaling-factor \
      color-scheme accent-color \
      gtk-theme icon-theme cursor-theme cursor-size \
      enable-animations \
      clock-format clock-show-date clock-show-weekday clock-show-seconds \
      show-battery-percentage
    printf '\n'

    printf '[org/gnome/desktop/wm/preferences]\n'
    emit_keys "${user}" org.gnome.desktop.wm.preferences titlebar-font
    printf '\n'

    printf '[org/gnome/settings-daemon/plugins/color]\n'
    emit_keys "${user}" org.gnome.settings-daemon.plugins.color \
      night-light-enabled \
      night-light-schedule-automatic \
      night-light-schedule-from \
      night-light-schedule-to \
      night-light-temperature
    printf '\n'

    printf '[org/gnome/settings-daemon/plugins/power]\n'
    emit_keys "${user}" org.gnome.settings-daemon.plugins.power \
      ambient-enabled \
      idle-brightness \
      idle-dim \
      power-button-action \
      power-saver-profile-on-low-battery \
      sleep-inactive-ac-timeout \
      sleep-inactive-ac-type \
      sleep-inactive-battery-timeout \
      sleep-inactive-battery-type
    printf '\n'

    printf '[org/gnome/desktop/peripherals/mouse]\n'
    emit_keys "${user}" org.gnome.desktop.peripherals.mouse \
      accel-profile speed natural-scroll left-handed middle-click-emulation
    printf '\n'

    printf '[org/gnome/desktop/peripherals/touchpad]\n'
    emit_keys "${user}" org.gnome.desktop.peripherals.touchpad \
      accel-profile speed natural-scroll tap-to-click \
      disable-while-typing click-method two-finger-scrolling-enabled \
      edge-scrolling-enabled send-events
    printf '\n'

    printf '[org/gnome/desktop/a11y/interface]\n'
    emit_keys "${user}" org.gnome.desktop.a11y.interface \
      high-contrast show-status-shapes
    printf '\n'

    printf '[org/gnome/desktop/sound]\n'
    emit_keys "${user}" org.gnome.desktop.sound \
      event-sounds allow-volume-above-100-percent theme-name
    printf '\n'
  } >"${tmp}"

  mkdir -p "$(dirname -- "${GDM_DCONF_PATH}")"
  if ! cmp -s "${tmp}" "${GDM_DCONF_PATH}" 2>/dev/null; then
    install -m 0644 "${tmp}" "${GDM_DCONF_PATH}"
    log "wrote ${GDM_DCONF_PATH}"
    if dconf compile "${GDM_DCONF_DB}" "${GDM_DCONF_D}" 2>/dev/null; then
      log "compiled ${GDM_DCONF_DB}"
    else
      log "warning: dconf compile failed"
    fi
  else
    log "dconf drop-in unchanged"
  fi
  rm -f "${tmp}"
}

sync_monitors() {
  local user="$1"
  local home src gdm_home
  home="$(getent passwd "${user}" | cut -d: -f6)"
  src="${home}/.config/monitors.xml"
  if [[ ! -f "${src}" ]]; then
    log "no ${src} (skip monitors)"
    return 0
  fi

  gdm_home="$(getent passwd gdm | cut -d: -f6)"
  if [[ -z "${gdm_home}" ]]; then
    log "warning: gdm user not found (skip monitors)"
    return 0
  fi

  install -d -o gdm -g gdm -m 755 "${gdm_home}/.config"
  install -o gdm -g gdm -m 644 "${src}" "${GDM_MONITORS_HOME}"
  install -d -m 755 /etc/xdg
  install -o root -g root -m 644 "${src}" "${GDM_MONITORS_XDG}"
  log "synced monitors.xml → ${GDM_MONITORS_HOME} and ${GDM_MONITORS_XDG}"
}

resolve_user() {
  local explicit="${1:-}"
  if [[ -n "${explicit}" ]]; then
    printf '%s\n' "${explicit}"
    return 0
  fi
  if [[ -f "${CONFIG_USER_FILE}" ]]; then
    local stored
    stored="$(tr -d '[:space:]' <"${CONFIG_USER_FILE}")"
    if [[ -n "${stored}" ]] && id "${stored}" &>/dev/null; then
      printf '%s\n' "${stored}"
      return 0
    fi
  fi
  return 1
}

run_once() {
  local user_arg="${1:-}"
  local user

  if ! user="$(resolve_user "${user_arg}")"; then
    log "error: no user (pass --user or set ${CONFIG_USER_FILE})"
    return 0
  fi
  if ! getent passwd "${user}" >/dev/null; then
    log "error: user not found: ${user}"
    return 0
  fi

  log "start sync for user=${user}"
  write_gdm_dconf "${user}" || log "warning: dconf sync failed"
  sync_monitors "${user}" || log "warning: monitors sync failed"
  log "done"
  return 0
}

is_dconf_event() {
  case "$1" in
    */org/gnome/desktop/interface/* | \
    */org/gnome/desktop/wm/preferences/* | \
    */org/gnome/settings-daemon/plugins/color/* | \
    */org/gnome/settings-daemon/plugins/power/* | \
    */org/gnome/desktop/peripherals/mouse/* | \
    */org/gnome/desktop/peripherals/touchpad/* | \
    */org/gnome/desktop/a11y/interface/* | \
    */org/gnome/desktop/sound/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

wait_user_bus() {
  local user="$1" uid
  uid="$(id -u "${user}")"
  wait_session_bus "${uid}" || return 1
}

watch_dconf() {
  local user="$1" debounce_pid=""
  as_user "${user}" stdbuf -oL gdbus monitor --session \
    --dest ca.desrt.dconf --object-path /ca/desrt/dconf/Writer/user 2>/dev/null \
  | while read -r line; do
      is_dconf_event "${line}" || continue
      debounce_run debounce_pid write_gdm_dconf "${user}"
    done
}

watch_monitors() {
  local user="$1" home cfg debounce_pid=""
  home="$(getent passwd "${user}" | cut -d: -f6)"
  cfg="${home}/.config"
  mkdir -p "${cfg}"

  # Directory watch: file may be replaced/rewritten by mutter.
  inotifywait -m -e close_write,moved_to,create --format '%f' "${cfg}" 2>/dev/null \
  | while read -r name; do
      [[ "${name}" == "monitors.xml" ]] || continue
      debounce_run debounce_pid sync_monitors "${user}"
    done
}

run_daemon() {
  local user_arg="${1:-}"
  local user dconf_pid monitors_pid

  if ! user="$(resolve_user "${user_arg}")"; then
    log "error: no user (pass --user or set ${CONFIG_USER_FILE})"
    exit 0
  fi
  if ! getent passwd "${user}" >/dev/null; then
    log "error: user not found: ${user}"
    exit 0
  fi
  if ! command -v inotifywait >/dev/null 2>&1; then
    log "error: inotifywait not found (install inotify-tools)"
    exit 1
  fi

  log "waiting for session bus (${user})"
  if ! wait_user_bus "${user}"; then
    log "no session bus for ${user}; exit"
    exit 0
  fi

  log "watching dconf + monitors.xml for ${user}"
  watch_dconf "${user}" &
  dconf_pid=$!
  watch_monitors "${user}" &
  monitors_pid=$!

  # Exit when either watcher ends (typically session bus gone on logout).
  wait -n "${dconf_pid}" "${monitors_pid}" 2>/dev/null || true
  kill "${dconf_pid}" "${monitors_pid}" 2>/dev/null || true
  wait "${dconf_pid}" "${monitors_pid}" 2>/dev/null || true
  log "watchers stopped"
  exit 0
}

user_arg=""
once_mode=0

while [[ "${#}" -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --once)
      once_mode=1
      shift
      ;;
    --user)
      user_arg="${2:-}"
      if [[ -z "${user_arg}" ]]; then
        log "error: --user needs a name"
        exit 0
      fi
      shift 2
      ;;
    *)
      log "error: unknown argument: $1"
      usage >&2
      exit 0
      ;;
  esac
done

if ((once_mode)); then
  run_once "${user_arg}" || true
  exit 0
fi

run_daemon "${user_arg}"
