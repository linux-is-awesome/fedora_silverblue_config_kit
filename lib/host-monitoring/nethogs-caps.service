[Unit]
Description=Install capped nethogs under /usr/local for per-process network monitoring
After=local-fs.target
# Ostree /usr is read-only — copy the RPM binary into /usr/local, then setcap.
ConditionPathExists=|/usr/sbin/nethogs
ConditionPathExists=|/usr/bin/nethogs

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'set -euo pipefail; \
  src=""; \
  for p in /usr/sbin/nethogs /usr/bin/nethogs; do \
    [[ -x "$p" ]] || continue; \
    src="$p"; \
    break; \
  done; \
  [[ -n "$src" ]] || exit 1; \
  install -D -m 755 "$src" /usr/local/bin/nethogs; \
  /usr/sbin/setcap cap_net_admin,cap_net_raw,cap_dac_read_search,cap_sys_ptrace+ep /usr/local/bin/nethogs; \
  /usr/sbin/getcap /usr/local/bin/nethogs'

[Install]
WantedBy=multi-user.target
