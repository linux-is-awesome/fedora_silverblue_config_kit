#!/usr/bin/env bash
# Remove a Samba usershare by directory path or share name.
# Usage: share-off PATH|SHARE_NAME
set -euo pipefail

[[ "${#}" -ge 1 ]] || {
  printf 'usage: %s PATH|SHARE_NAME\n' "$(basename -- "$0")" >&2
  exit 2
}

arg="$1"
if [[ -d "${arg}" ]]; then
  name="$(basename -- "$(readlink -f -- "${arg}")")"
else
  name="${arg}"
fi
name="${name// /_}"

net usershare delete "${name}" >/dev/null 2>&1 || true
